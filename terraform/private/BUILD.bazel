load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//terraform:__subpackages__"])

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "library",
    srcs = ["library.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "runner",
    srcs = ["runner.bzl"],
    deps = [
        ":providers",
        "//toolchain:toolchain_bzl",
    ],
)

bzl_library(
    name = "deploy",
    srcs = ["deploy.bzl"],
    deps = [
        ":providers",
        ":runner",
    ],
)
