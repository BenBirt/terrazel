load("@rules_tofu//tf:defs.bzl", "tf_library")

# main.tf references `var.does_not_exist`, which `tofu validate` rejects
# with "Reference to undeclared input variable". The build-time
# validate action inside tf_library propagates that failure.
tf_library(
    name = "bad",
    srcs = ["main.tf"],
    fmt_test = False,
)
