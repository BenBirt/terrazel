load("@rules_tofu//tf:defs.bzl", "tf_deploy", "tf_library")

# `vars` and `extra.tfvars.json` both declare `foo`. The dupcheck action
# emitted by tf_deploy must fail at build time with
# "... declared in both ...".
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    fmt_test = False,
)

tf_deploy(
    name = "dup",
    fmt_test = False,
    var_files = ["extra.tfvars.json"],
    vars = {"foo": "from-vars"},
    deps = [":lib"],
)

# Same check but using a standard HCL .tfvars file instead of JSON.
tf_deploy(
    name = "dup_hcl",
    fmt_test = False,
    var_files = ["extra.tfvars"],
    vars = {"foo": "from-vars"},
    deps = [":lib"],
)
