load("@rules_tofu//tf:defs.bzl", "tf_library")

# Referencing a file belonging to an external Bazel workspace/module in data
# must fail during materialization since Terraform cannot address files outside the workspace root.
tf_library(
    name = "lib",
    srcs = ["main.tf"],
    data = ["@rules_tofu//tf:defs.bzl"],
    fmt_test = False,
)
