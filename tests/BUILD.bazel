load("@bazel_skylib//rules:build_test.bzl", "build_test")

# Verifies that the example targets analyze + build (and therefore that the
# generated plan/apply wrapper scripts exist on disk after a build).
build_test(
    name = "example_build_test",
    targets = [
        "//examples/hello:hello",
        "//examples/hello:hello.plan",
        "//examples/hello:hello.apply",
        "//examples/hello:greet_lib",
    ],
)
