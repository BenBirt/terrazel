"""Minimal downstream module that consumes rules_tofu exactly as the README
quick-start documents. This is the BCR presubmit test module: it validates that
the *published* artifact builds and that `tf_library` / `tf_deploy` work for a
real consumer, offline and without credentials.

`local_path_override` points at the repo root so the same module also runs
locally via `cd e2e/smoke && bazel build //... && bazel test //...`. Under BCR
presubmit the override is ignored and rules_tofu is fetched from the registry.
"""

bazel_dep(name = "rules_tofu", version = "0.0.0")
local_path_override(
    module_name = "rules_tofu",
    path = "../..",
)

tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")
